# CodeWalk Agent: production stack configuration (docker-compose.prod.yml).
#
#   cp .env.production.example .env.production      # .env.production is git-ignored
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build --wait
#
# Placeholders only. Generate every secret on the server; never commit the real file, and prefer
# your platform's secret manager where one exists (docs/deployment/secrets.md).

# --- Required ------------------------------------------------------------------------------
# Database password: URL-safe characters only (it is embedded in the backend's database URL).
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
POSTGRES_PASSWORD=replace-me
# Application secret: at least 32 random characters (the backend refuses to start otherwise).
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CODEWALK_SECRET_KEY=replace-with-random-secret

# --- Public address ------------------------------------------------------------------------
# The browser-facing origin, e.g. https://codewalk.example.com (https only in production).
# Empty = same-origin only, which is correct when frontend and API are both served by the proxy.
CODEWALK_PUBLIC_ORIGIN=
# on: the proxy terminates TLS (certificates in CODEWALK_TLS_DIR); off: plain HTTP on port 8080
# inside the container (local runs, or behind a load balancer that terminates TLS).
CODEWALK_PROXY_TLS=off
# Host interface and ports published by the proxy (the only published service).
CODEWALK_BIND_ADDRESS=0.0.0.0
CODEWALK_HTTP_PORT=80
CODEWALK_HTTPS_PORT=443
# Host folders mounted read-only into the proxy: fullchain.pem + privkey.pem, and the ACME webroot.
CODEWALK_TLS_DIR=./deploy/certs
CODEWALK_ACME_DIR=./deploy/acme

# --- Database ------------------------------------------------------------------------------
POSTGRES_USER=codewalk
POSTGRES_DB=codewalk
CODEWALK_DATABASE_POOL_SIZE=5

# --- Images --------------------------------------------------------------------------------
# Tag (and optional registry prefix ending in "/") of the images to run; rollback = previous tag.
CODEWALK_IMAGE_TAG=local
CODEWALK_IMAGE_REGISTRY=

# --- Logging -------------------------------------------------------------------------------
CODEWALK_LOG_FORMAT=json
CODEWALK_LOG_LEVEL=INFO

# --- Optional AI assistance and semantic retrieval ------------------------------------------
# Backend-only. Without keys the app runs normally and reports AI/retrieval as unavailable.
CODEWALK_AI_ENABLED=false
CODEWALK_AI_PROVIDER=
CODEWALK_AI_MODEL=
ANTHROPIC_API_KEY=
CODEWALK_AI_API_KEY=
RAG_ENABLED=false
RAG_EMBEDDING_PROVIDER=
RAG_EMBEDDING_MODEL=
VOYAGE_API_KEY=
