# CodeWalk Agent configuration. Copy to .env (never commit .env).
# Both backend and frontend read this repository-level file in development.

# ---------------------------------------------------------------------------
# Backend (FastAPI) — all variables use the CODEWALK_ prefix
# ---------------------------------------------------------------------------
# development | testing | production
CODEWALK_ENV=development
CODEWALK_HOST=127.0.0.1
CODEWALK_PORT=8000
CODEWALK_API_V1_PREFIX=/api/v1

# Comma-separated list of frontend origins allowed by CORS. "*" is rejected.
CODEWALK_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Interactive API docs (/docs). Defaults to on, except in production.
# CODEWALK_DOCS_ENABLED=true

# Required in production: at least 32 random characters.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
CODEWALK_SECRET_KEY=

# DEBUG | INFO | WARNING | ERROR | CRITICAL ; format: text | json
CODEWALK_LOG_LEVEL=INFO
CODEWALK_LOG_FORMAT=text

# Request limits (bytes)
CODEWALK_MAX_REQUEST_BODY_BYTES=2097152
CODEWALK_MAX_UPLOAD_BYTES=26214400

# Seconds allowed per dependency check in GET /api/v1/health
CODEWALK_HEALTH_CHECK_TIMEOUT_SECONDS=3

# --- Reserved for upcoming modules (read by settings, not used yet) ---------
# PostgreSQL (persistence module), e.g. postgresql+psycopg://user:password@localhost:5432/codewalk
CODEWALK_DATABASE_URL=
# AI provider (AI analysis module)
CODEWALK_AI_PROVIDER=
CODEWALK_AI_MODEL=
CODEWALK_AI_API_KEY=
CODEWALK_AI_REQUEST_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# Frontend (Next.js) — NEXT_PUBLIC_* values are embedded in the browser bundle.
# Never put secrets in NEXT_PUBLIC_* variables.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_API_TIMEOUT_MS=10000
NEXT_PUBLIC_HEALTH_POLL_INTERVAL_MS=15000
