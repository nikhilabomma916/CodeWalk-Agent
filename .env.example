# CodeWalk Agent configuration. Copy to .env (never commit .env).
# Both backend and frontend read this repository-level file in development.

# ---------------------------------------------------------------------------
# Backend (FastAPI) — all variables use the CODEWALK_ prefix
# ---------------------------------------------------------------------------
# development | testing | production
CODEWALK_ENV=development
CODEWALK_HOST=127.0.0.1
CODEWALK_PORT=8000
CODEWALK_API_V1_PREFIX=/api/v1

# Comma-separated list of frontend origins allowed by CORS. "*" is rejected.
CODEWALK_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Interactive API docs (/docs). Defaults to on, except in production.
# CODEWALK_DOCS_ENABLED=true

# Required in production: at least 32 random characters.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
CODEWALK_SECRET_KEY=

# DEBUG | INFO | WARNING | ERROR | CRITICAL ; format: text | json
CODEWALK_LOG_LEVEL=INFO
CODEWALK_LOG_FORMAT=text

# Request limits (bytes). The body limit must exceed CODEWALK_MAX_SOURCE_BYTES.
CODEWALK_MAX_REQUEST_BODY_BYTES=6291456
CODEWALK_MAX_UPLOAD_BYTES=26214400

# Seconds allowed per dependency check in GET /api/v1/health
CODEWALK_HEALTH_CHECK_TIMEOUT_SECONDS=3

# --- PostgreSQL (persistence) -----------------------------------------------
# Start it with:  docker compose up -d postgres   then:  npm run db:migrate
# docker-compose.yml reads POSTGRES_*; keep them in sync with the URL below.
# Without a database URL the API still serves code analysis; persistence returns 503.
# Use 127.0.0.1, not localhost: on Windows "localhost" tries IPv6 ::1 first, which the
# container port (bound to 127.0.0.1) does not answer, adding a multi-second delay.
POSTGRES_USER=codewalk
# Required: a random local password, for example: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Use the same value in both database URLs below.
POSTGRES_PASSWORD=
POSTGRES_DB=codewalk
POSTGRES_PORT=5432
CODEWALK_DATABASE_URL=postgresql+psycopg://codewalk:CHANGE_ME@127.0.0.1:5432/codewalk
# CODEWALK_DATABASE_POOL_SIZE=5
# CODEWALK_DATABASE_CONNECT_TIMEOUT_SECONDS=5
# Dedicated test database (name must end in _test; created by the compose init script).
# The PostgreSQL tests in backend/tests/db are skipped when this is unset.
CODEWALK_TEST_DATABASE_URL=postgresql+psycopg://codewalk:CHANGE_ME@127.0.0.1:5432/codewalk_test

# --- Accounts & sessions ------------------------------------------------------
# Sign-in lifetime in hours (session cookie: httpOnly, SameSite=Lax).
# CODEWALK_SESSION_TTL_HOURS=168
# CODEWALK_SESSION_COOKIE_NAME=codewalk_session
# Send the cookie over HTTPS only. Defaults to true in production, false otherwise.
# CODEWALK_SESSION_COOKIE_SECURE=
# Failed sign-ins per client address + email, and registrations per address, per window.
# CODEWALK_LOGIN_MAX_ATTEMPTS=10
# CODEWALK_LOGIN_WINDOW_SECONDS=900
# CODEWALK_REGISTER_MAX_ATTEMPTS=20
# CODEWALK_REGISTER_WINDOW_SECONDS=3600
# Saved versions kept per project file.
# CODEWALK_FILE_VERSION_HISTORY_LIMIT=50

# --- Analysis & project intelligence -----------------------------------------
# Largest source file analyzed or stored (bytes) and per-analyzer timeout (seconds).
# CODEWALK_MAX_SOURCE_BYTES=2097152
# CODEWALK_ANALYSIS_TIMEOUT_SECONDS=10
# Node.js binary for the TypeScript analyzer (found on PATH when unset).
# CODEWALK_NODE_BINARY=
# Code analyses kept per stored file.
# CODEWALK_ANALYSIS_HISTORY_PER_FILE=20
# Absolute server folder whose sub-folders can be linked to projects and scanned.
# Scanning is disabled when unset; nothing outside it is ever read.
# CODEWALK_WORKSPACE_ROOT=
# CODEWALK_SCAN_MAX_FILES=10000

# --- AI assistance (AI review, explanations, fix suggestions) ---------------
# Off unless enabled AND a provider credential is present. Without it, everything
# else works and the AI endpoints answer 503 ai_disabled / ai_not_configured.
CODEWALK_AI_ENABLED=false
# Provider: anthropic (the only one implemented). Model: provider default when empty
# (claude-opus-5-5).
CODEWALK_AI_PROVIDER=anthropic
CODEWALK_AI_MODEL=
# Server-side credential only; never put it in NEXT_PUBLIC_* variables. Either one works
# (CODEWALK_AI_API_KEY wins). Leave empty in this file; set it in your local .env.
ANTHROPIC_API_KEY=
CODEWALK_AI_API_KEY=
CODEWALK_AI_TIMEOUT_SECONDS=90
CODEWALK_AI_MAX_TOKENS=16000
# Reasoning effort: low | medium | high | xhigh | max
CODEWALK_AI_EFFORT=high
# AI requests per user within the window (then HTTP 429).
CODEWALK_AI_MAX_REQUESTS=30
CODEWALK_AI_WINDOW_SECONDS=600

# --- Semantic retrieval (Module 10: code embeddings in PostgreSQL/pgvector) ---
# Off unless enabled AND an embedding credential is present. Without it, deterministic
# project search and the AI features work as before; semantic/hybrid searches fall back
# to deterministic results with a warning, and indexing answers 503.
# Needs the pgvector image from docker-compose.yml (pgvector/pgvector:pg17-bookworm).
RAG_ENABLED=
# Provider: voyage (the only one implemented). Model: provider default when empty
# (voyage-code-4, 1024 dimensions).
RAG_EMBEDDING_PROVIDER=
RAG_EMBEDDING_MODEL=
# Server-side credential only; never put it in NEXT_PUBLIC_* variables.
# Leave empty in this file; set it in your local .env.
VOYAGE_API_KEY=
CODEWALK_RAG_TIMEOUT_SECONDS=30
# Query embeddings per user within the window (semantic searches and AI context); past it,
# searches fall back to deterministic results.
CODEWALK_RAG_MAX_QUERIES=120
# Indexing runs per user within the window (then HTTP 429).
CODEWALK_RAG_MAX_INDEX_RUNS=10
CODEWALK_RAG_WINDOW_SECONDS=600
# Chunks embedded per indexing run (larger projects are indexed over several runs).
CODEWALK_RAG_MAX_CHUNKS_PER_RUN=2000

# --- Agent (Module 11: project-aware agent over the AI provider) ----------------
# Uses the AI settings above (it is unavailable while AI is off). Each run is a bounded
# loop of model steps; every step calls one policy-checked, read-only tool or answers.
# Proposed changes are stored for review and applied only by an explicit approval.
# Model steps per run (each: one tool call or the answer).
CODEWALK_AGENT_MAX_STEPS=8
# Wall-clock limit for one run, all steps included.
CODEWALK_AGENT_TIMEOUT_SECONDS=240
# Tool output kept in the agent's context (characters).
CODEWALK_AGENT_MAX_CONTEXT_CHARS=60000
# Proposed changes per run.
CODEWALK_AGENT_MAX_ACTIONS=3
# Agent runs per user within the window (then HTTP 429).
CODEWALK_AGENT_MAX_RUNS=20
CODEWALK_AGENT_WINDOW_SECONDS=600

# ---------------------------------------------------------------------------
# Frontend (Next.js) — NEXT_PUBLIC_* values are embedded in the browser bundle.
# Never put secrets in NEXT_PUBLIC_* variables.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_API_TIMEOUT_MS=10000
NEXT_PUBLIC_HEALTH_POLL_INTERVAL_MS=15000
