# CodeWalk Agent configuration. Copy to .env (never commit .env).
# Both backend and frontend read this repository-level file in development.

# ---------------------------------------------------------------------------
# Backend (FastAPI) — all variables use the CODEWALK_ prefix
# ---------------------------------------------------------------------------
# development | testing | production
CODEWALK_ENV=development
CODEWALK_HOST=127.0.0.1
CODEWALK_PORT=8000
CODEWALK_API_V1_PREFIX=/api/v1

# Comma-separated list of frontend origins allowed by CORS. "*" is rejected.
CODEWALK_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Interactive API docs (/docs). Defaults to on, except in production.
# CODEWALK_DOCS_ENABLED=true

# Required in production: at least 32 random characters.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
CODEWALK_SECRET_KEY=

# DEBUG | INFO | WARNING | ERROR | CRITICAL ; format: text | json
CODEWALK_LOG_LEVEL=INFO
CODEWALK_LOG_FORMAT=text

# Request limits (bytes). The body limit must exceed CODEWALK_MAX_SOURCE_BYTES.
CODEWALK_MAX_REQUEST_BODY_BYTES=6291456
CODEWALK_MAX_UPLOAD_BYTES=26214400

# Seconds allowed per dependency check in GET /api/v1/health
CODEWALK_HEALTH_CHECK_TIMEOUT_SECONDS=3

# --- PostgreSQL (persistence) -----------------------------------------------
# Start it with:  docker compose up -d postgres   then:  npm run db:migrate
# docker-compose.yml reads POSTGRES_*; keep them in sync with the URL below.
# Without a database URL the API still serves code analysis; persistence returns 503.
# Use 127.0.0.1, not localhost: on Windows "localhost" tries IPv6 ::1 first, which the
# container port (bound to 127.0.0.1) does not answer, adding a multi-second delay.
POSTGRES_USER=codewalk
POSTGRES_PASSWORD=codewalk_dev_password
POSTGRES_DB=codewalk
POSTGRES_PORT=5432
CODEWALK_DATABASE_URL=postgresql+psycopg://codewalk:codewalk_dev_password@127.0.0.1:5432/codewalk
# CODEWALK_DATABASE_POOL_SIZE=5
# CODEWALK_DATABASE_CONNECT_TIMEOUT_SECONDS=5
# Dedicated test database (name must end in _test; created by the compose init script).
# The PostgreSQL tests in backend/tests/db are skipped when this is unset.
CODEWALK_TEST_DATABASE_URL=postgresql+psycopg://codewalk:codewalk_dev_password@127.0.0.1:5432/codewalk_test

# --- Analysis & project intelligence -----------------------------------------
# Largest source file analyzed or stored (bytes) and per-analyzer timeout (seconds).
# CODEWALK_MAX_SOURCE_BYTES=2097152
# CODEWALK_ANALYSIS_TIMEOUT_SECONDS=10
# Node.js binary for the TypeScript analyzer (found on PATH when unset).
# CODEWALK_NODE_BINARY=
# Code analyses kept per stored file.
# CODEWALK_ANALYSIS_HISTORY_PER_FILE=20
# Absolute server folder whose sub-folders can be linked to projects and scanned.
# Scanning is disabled when unset; nothing outside it is ever read.
# CODEWALK_WORKSPACE_ROOT=
# CODEWALK_SCAN_MAX_FILES=10000

# --- Reserved for upcoming modules (read by settings, not used yet) ---------
# AI provider (AI analysis module)
CODEWALK_AI_PROVIDER=
CODEWALK_AI_MODEL=
CODEWALK_AI_API_KEY=
CODEWALK_AI_REQUEST_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# Frontend (Next.js) — NEXT_PUBLIC_* values are embedded in the browser bundle.
# Never put secrets in NEXT_PUBLIC_* variables.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_API_TIMEOUT_MS=10000
NEXT_PUBLIC_HEALTH_POLL_INTERVAL_MS=15000
